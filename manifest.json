{
  "manifest_version": 3,
  "name": "AI Overview Remover",
  "version": "2.0.0",
  "description": "Removes AI-generated previews from Google search results.",
  "content_scripts": [
    {
      "matches": ["*://www.google.com/search*"],
      "js": ["content.js"],
      "css": ["hide.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ]
}